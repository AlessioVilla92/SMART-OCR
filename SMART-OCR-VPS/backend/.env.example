# === Smart OCR Backend ===
SECRET_KEY=change-me-to-a-random-64-char-string
DATABASE_URL=sqlite:///./smart_ocr.db
REDIS_URL=redis://127.0.0.1:6379/0

# JWT
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# Job retention (seconds) — results deleted from Redis after this
JOB_RETENTION_SECONDS=3600

# Celery
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

# Pipeline — path to smart_ocr package (relative to backend/)
SMART_OCR_DIR=../../smart_ocr

# ARM64 optimizations (uncomment on Raspberry Pi)
# OPENCV_NUM_THREADS=2
# OMP_NUM_THREADS=2
# ORT_NUM_THREADS=2
# DISABLE_DOCALIGNER=1
# ORT_PROVIDERS=CPUExecutionProvider
